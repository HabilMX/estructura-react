{
  "name": "estructura-react",
  "version": "0.1.0",
  "private": true,
  "description": "La sala de la tienda de pedidos: una plantilla de React con TypeScript y Vite, con la estructura por funcionalidad y una frontera que sabe fallar",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node herramientas/revisar-presupuesto.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --check .",
    "test": "vitest run",
    "verificar": "npm run typecheck && npm run lint && npm run format && npm test && npm run build",
    "contrato": "CONTRATO=1 VITE_API_URL=${VITE_API_URL:-http://localhost:8080} vitest run"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-boundaries": "^7.4.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "msw": "^3.0.7",
    "prettier": "^3.10.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
